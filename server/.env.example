# =============================================================================
# P.D.O Classes API - environment template
# Copy to server/.env and replace every placeholder. Never commit server/.env.
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173
# Tenant that owns the public landing page + demo booking form.
PUBLIC_INSTITUTE_SLUG=pdo-classes

# ---- PostgreSQL ------------------------------------------------------------
# Application pool: restricted, non-owner role. RLS is enforced here.
# The password must match the ALTER ROLE statement in the README.
DATABASE_URL=postgresql://pdo_app:change_me_to_your_app_password@localhost:5432/pdo_classes
# Owner pool used ONLY by `npm run db:migrate` and `npm run db:seed`.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/pdo_classes
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Redis / BullMQ --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- JWT -------------------------------------------------------------------
JWT_SECRET=dev_only_change_me_7f3c1a9e5b2d4f6a8c0e1b3d5f7a9c2e
JWT_REFRESH_SECRET=dev_only_change_me_2b8d4f6a9c0e1b3d5f7a9c2e4f6a8b0d
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=pdo-classes-api
JWT_AUDIENCE=pdo-classes-client

# ---- Password hashing / demo seed -----------------------------------------
# BCRYPT_ROUNDS must be >= 10 (governance rule 3.x).
BCRYPT_ROUNDS=12
SEED_DEFAULT_PASSWORD=PdoClasses@2026

# ---- WhatsApp Cloud API (Meta) --------------------------------------------
WHATSAPP_PROVIDER=META_CLOUD
WHATSAPP_PHONE_NUMBER_ID=<meta_phone_number_id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<meta_whatsapp_business_account_id>
WHATSAPP_ACCESS_TOKEN=<meta_permanent_access_token>
WHATSAPP_VERIFY_TOKEN=<webhook_verify_token>
WHATSAPP_APP_SECRET=<meta_app_secret_for_hmac_validation>

# ---- Escalation Engine Timers ---------------------------------------------
# Delay before sending WhatsApp verification to parents (default 10 min = 600000 ms).
# Use small values (e.g., 15000) for local testing.
ATTENDANCE_VERIFY_DELAY_MS=600000
# Parent reply window before escalating to Red Alert (default 3 min = 180000 ms).
# Use small values (e.g., 10000) for local testing.
PARENT_REPLY_WINDOW_MS=180000
# Enable mock WhatsApp mode for local testing (logs to console instead of calling Meta API)
WHATSAPP_MOCK_MODE=true
