# =============================================================================
# P.D.O Classes web client - public environment template
# Copy to client/.env. Vite only exposes VITE_* variables to the browser.
# =============================================================================

VITE_APP_NAME=P.D.O Classes
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_INSTITUTE_SLUG=pdo-classes

# -----------------------------------------------------------------------------
# Server-only secrets are intentionally NOT configured here. PostgreSQL, Redis,
# JWT and WhatsApp credentials live in server/.env (see server/.env.example) and
# must never be exposed through VITE_* variables or the client bundle.
# -----------------------------------------------------------------------------
